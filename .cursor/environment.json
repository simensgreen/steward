{
  "name": "Steward",
  "user": "ubuntu",
  "install": "./scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "steward-server",
      "command": "export RUSTUP_TOOLCHAIN=stable && cargo run -p steward-server"
    },
    {
      "name": "web",
      "command": "cd web && npm run dev -- --host 127.0.0.1"
    }
  ],
  "ports": [
    { "name": "api", "port": 8080 },
    { "name": "web", "port": 5173 }
  ]
}
